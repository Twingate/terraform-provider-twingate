# Twingate provider settings
tg_api_token = "your-api-token"
tg_network   = "your-network"
# tg_url     = "twingate.com"  # override the default Twingate domain

# GCP settings
project_id = "your-gcp-project"

# Public CA settings
# The certificate covers *.<domain>, and the Resource alias is httpbin.<domain>
domain     = "gce.example.com"
acme_email = "you@example.com"
